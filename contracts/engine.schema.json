      "required": [
        "url",
        "platform",
        "title",
        "formats",
        "can_download"
      ],
      "title": "Inspection",
      "type": "object"
    },
    "Provider": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "vision": {
          "title": "Vision",
          "type": "boolean"
        },
        "key_set": {
          "default": false,
          "title": "Key Set",
          "type": "boolean"
        }
