        "base_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "vision": {
          "title": "Vision",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "base_url",
        "model",
        "vision"
      ],
      "title": "ProviderInput",
      "type": "object"
