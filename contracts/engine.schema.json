      "required": [
        "id",
        "label",
        "base_url",
        "model",
        "vision"
      ],
      "title": "Provider",
      "type": "object"
    },
    "ProviderInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
