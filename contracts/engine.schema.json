      "required": [
        "id",
        "asset_id",
        "provider_label",
        "model",
        "skill",
        "title",
        "summary",
        "markdown",
        "created_at",
        "source_sha256"
      ],
      "title": "Report",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "ffmpeg": {
          "title": "Ffmpeg",
          "type": "boolean"
        },
        "ffprobe": {
          "title": "Ffprobe",
          "type": "boolean"
        },
        "yt_dlp": {
          "title": "Yt Dlp",
          "type": "boolean"
        }
      },
      "required": [
        "ffmpeg",
        "ffprobe",
        "yt_dlp"
      ],
      "title": "Resources",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "import_video",
            "import_document",
            "download",
            "analysis",
            "export_report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "cancelled",
            "succeeded",
            "failed",
            "interrupted",
            "needs_attention"
          ],
          "title": "Status",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "attempt": {
          "default": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "stage",
        "created_at",
        "updated_at",
        "revision"
      ],
      "title": "Task",
      "type": "object"
    },
