{
  "$defs": {
    "AnalysisInput": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "skill": {
          "enum": [
            "comprehensive",
            "visual-shots",
            "highlights",
            "video-to-article",
            "screenplay-analysis"
          ],
          "title": "Skill",
          "type": "string"
        },
        "api_key": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Api Key",
          "type": "string"
        },
        "expected_provider_base_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Expected Provider Base Url",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        }
      },
      "required": [
        "asset_id",
        "provider_id",
        "skill",
        "api_key",
        "expected_provider_base_url"
      ],
      "title": "AnalysisInput",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "document"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "availability": {
          "default": "available",
          "enum": [
            "available",
            "missing",
            "changed"
          ],
          "title": "Availability",
          "type": "string"
        },
        "text_preview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Preview"
        },
        "mode": {
          "default": "reference",
          "enum": [
            "reference",
            "copy"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "size_bytes",
        "sha256",
        "created_at"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "import_video": {
          "title": "Import Video",
          "type": "boolean"
        },
        "import_document": {
          "title": "Import Document",
          "type": "boolean"
        },
        "download": {
          "title": "Download",
          "type": "boolean"
        },
        "analysis": {
          "title": "Analysis",
          "type": "boolean"
        }
      },
      "required": [
        "import_video",
        "import_document",
        "download",
        "analysis"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "DownloadInput": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "format_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Id"
        },
        "height": {
          "anyOf": [
            {
              "maximum": 4320,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "container": {
          "anyOf": [
            {
              "enum": [
                "mp4",
                "webm",
                "mkv"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "url",
        "operation_id"
      ],
      "title": "DownloadInput",
      "type": "object"
    },
    "EngineHello": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "1",
          "default": "1",
          "title": "Protocol Version",
          "type": "string"
        },
        "engine_version": {
          "default": "0.1.0",
          "title": "Engine Version",
          "type": "string"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        }
      },
      "required": [
        "capabilities",
        "resources"
      ],
      "title": "EngineHello",
      "type": "object"
    },
    "ImportInput": {
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "maxLength": 32768,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "mode": {
          "enum": [
            "reference",
            "copy"
          ],
          "title": "Mode",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "mode",
        "operation_id"
      ],
      "title": "ImportInput",
      "type": "object"
    },
    "Inspection": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "platform": {
          "enum": [
            "youtube",
            "bilibili",
            "unsupported"
          ],
          "title": "Platform",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "formats": {
          "items": {
            "$ref": "#/$defs/VideoFormat"
          },
          "title": "Formats",
          "type": "array"
        },
        "can_download": {
          "title": "Can Download",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
