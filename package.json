{
  "name": "video-electron",
  "version": "0.1.0",
  "private": true,
  "description": "帧取独立桌面视频工作站",
  "author": "Stephen Qiu",
  "license": "MIT",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run && pnpm test:packaging",
    "test:e2e": "playwright test",
    "test:engine": "uv run --project engine pytest engine/tests",
    "test:packaging": "node --test tests/packaging/*.test.mjs",
    "contract:generate": "uv run --project engine python -m framefetch_desktop.export_schema && node scripts/generate-contract.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "runtime:freeze": "node scripts/freeze-engine.mjs",
    "runtime:verify": "node scripts/verify-runtime.mjs",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package": "pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "json-schema-to-typescript": "16.0.0",
    "node-gyp": "13.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
