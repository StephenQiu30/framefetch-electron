{
  "name": "video-electron",
  "version": "0.2.0",
  "private": true,
  "description": "帧取桌面客户端，直接复用现有 Frontend 与 Server",
  "author": "Stephen Qiu",
  "license": "MIT",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "build": "vite build && vite build --config renderer.vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package": "pnpm build && electron-builder --publish never",
    "frontend:sync": "node scripts/sync-frontend.mjs",
    "frontend:check": "node scripts/sync-frontend.mjs --check",
    "openapi": "node node_modules/@umijs/openapi/dist/cli.js",
    "openapi:check": "pnpm openapi && git diff --exit-code -- src/renderer/frontend/api",
    "frontend:check-upstream": "node scripts/sync-frontend.mjs --check-upstream"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "shadcn": "4.21.0",
    "@umijs/openapi": "1.14.1",
    "@tailwindcss/vite": "^4.3.3"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "9.2.4",
    "@vidstack/react": "1.15.6",
    "axios": "1.19.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-is": "19.2.7",
    "react-markdown": "10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0"
  }
}
